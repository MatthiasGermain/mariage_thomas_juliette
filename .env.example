# Copier ce fichier en .env pour le développement local.
# En production, ces valeurs sont des variables d'environnement Vercel.

# Mot de passe d'inscription au repas (donné sur le faire-part)
REPAS_PASSWORD=

# Application web Apps Script du tableur (voir google-apps-script/Code.gs).
# Laisser vide en local : les réponses vont alors dans .data/reponses.json.
# URL du déploiement, de la forme https://script.google.com/macros/s/<...>/exec
SHEETS_SCRIPT_URL=
# Secret partagé : même valeur que la propriété de script SECRET
SHEETS_SCRIPT_SECRET=
