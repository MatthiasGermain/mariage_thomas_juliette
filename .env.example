# Copier ce fichier en .env pour le développement local.
# En production, ces valeurs sont des variables d'environnement Vercel.

# Mot de passe d'inscription au repas (donné sur le faire-part)
REPAS_PASSWORD=

# Compte de service Google (laisser vide en local : les réponses vont dans .data/reponses.json)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clé privée sur une ligne, avec les retours à la ligne écrits \n
GOOGLE_PRIVATE_KEY=
# Identifiant du tableur (dans l'URL : /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=
