---
import { mariage } from '../data/content';
---

<footer class="pied">
  <img src="/images/logo.png" alt="" width="72" height="72" />
  <p class="script">{mariage.maries}</p>
  <p class="surtitre">{mariage.dateLongue}</p>
</footer>

<style>
  .pied {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 3rem var(--gouttiere);
    background: var(--cafe-noir);
    color: var(--creme-amande);
    text-align: center;
  }

  img {
    filter: invert(1) sepia(0.3) brightness(1.4);
    mix-blend-mode: screen;
  }

  p {
    margin: 0;
  }

  .script {
    font-size: 2rem;
  }
</style>
