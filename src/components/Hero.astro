---
import { mariage } from '../data/content';
---

<section id="bienvenue" class="hero rayures">
  <h1 class="script noms">Juliette <span class="et">&</span> Thomas</h1>

  <div class="scene">
    <a class="lien" href="#programme">Détails</a>

    <!-- Planche photomaton fournie (date incluse), fond détouré -->
    <figure class="photomaton">
      <img
        src="/images/photomaton.webp"
        alt={`Quatre photos de Juliette et Thomas prises au photomaton, avec la date du ${mariage.dateAffichee}`}
        width="683"
        height="870"
        fetchpriority="high"
      />
    </figure>

    <a class="lien" href="#presence">Confirme ta<br />présence</a>
  </div>

  <p class="accroche">ont la joie de vous inviter à leur mariage</p>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100svh;
    padding: clamp(6.5rem, 8vw, 7rem) var(--gouttiere) clamp(2rem, 4vw, 3.5rem);
    overflow: hidden;
  }

  .noms {
    position: relative;
    z-index: 2;
    font-size: clamp(2.6rem, 10vw, 9.5rem);
    line-height: 1;
    color: var(--olive);
    white-space: nowrap;
    /* Les noms chevauchent le haut du photomaton */
    margin-bottom: -0.55em;
    transform: rotate(-4deg);
  }

  .et {
    font-size: 0.9em;
  }

  .scene {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100%, 72rem);
  }

  .lien {
    justify-self: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(0.85rem, 1.6vw, 1.4rem);
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
    text-underline-offset: 0.2em;
    color: var(--brun-cendre);
  }

  .photomaton {
    position: relative;
    z-index: 1;
    margin: 0;
    width: clamp(15rem, 28.5vw, 24.5rem);
  }

  .photomaton img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 18px rgb(51 42 27 / 0.2));
  }

  .accroche {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(0.85rem, 1.6vw, 1.4rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: var(--brun-cendre);
  }

  @media (max-width: 40rem) {
    .noms {
      margin-top: 2.5rem;
    }
    .scene {
      grid-template-columns: 1fr 1fr;
      row-gap: 1.75rem;
    }
    .photomaton {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
      width: min(80vw, 20rem);
    }
  }
</style>
