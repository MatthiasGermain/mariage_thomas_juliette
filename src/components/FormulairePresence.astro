---
// Formulaire de confirmation de présence, envoyé à /api/<type> (voir src/lib/rsvp.ts).
interface Props {
  type: 'repas' | 'vin-honneur';
}

const { type } = Astro.props;
const avecCode = type === 'repas';
const id = (champ: string) => `${type}-${champ}`;
---

<form class="formulaire" data-presence={type} novalidate>
  {
    avecCode && (
      <label for={id('code')}>
        Code reçu sur le faire-part
        <input id={id('code')} name="code" type="password" required autocomplete="off" />
      </label>
    )
  }
  <div class="ligne">
    <label for={id('prenom')}>
      Prénom
      <input id={id('prenom')} name="prenom" required maxlength="100" autocomplete="given-name" />
    </label>
    <label for={id('nom')}>
      Nom
      <input id={id('nom')} name="nom" required maxlength="100" autocomplete="family-name" />
    </label>
  </div>
  <label for={id('personnes')}>
    Nombre de personnes (vous compris)
    <input id={id('personnes')} name="personnes" type="number" min="1" max="20" value="1" required />
  </label>

  <!-- Piège à robots : champ invisible qu'un humain laisse vide. -->
  <label class="visually-hidden" aria-hidden="true">
    Ne pas remplir
    <input name="site" tabindex="-1" autocomplete="off" />
  </label>

  <button class="bouton" type="submit">Confirmer</button>
  <p class="message" role="status" aria-live="polite"></p>
</form>

<script>
  // Petite pluie de confettis aux couleurs du mariage quand la réponse est enregistrée.
  const COULEURS = ['#332a1b', '#5b4734', '#e1973d', '#e7d6c2', '#6b734f'];

  function lancerConfettis(depuis: HTMLElement) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const r = depuis.getBoundingClientRect();
    // Dans une fenêtre modale, les confettis doivent être dans la fenêtre pour passer au-dessus
    const parent = depuis.closest('dialog') ?? document.body;
    for (let i = 0; i < 42; i++) {
      const c = document.createElement('span');
      const taille = 6 + Math.random() * 6;
      Object.assign(c.style, {
        position: 'fixed',
        left: `${r.left + r.width / 2}px`,
        top: `${r.top + r.height / 2}px`,
        width: `${taille}px`,
        height: `${taille * (Math.random() < 0.5 ? 0.45 : 1)}px`,
        background: COULEURS[i % COULEURS.length],
        borderRadius: Math.random() < 0.3 ? '50%' : '1px',
        pointerEvents: 'none',
        zIndex: '10',
      });
      parent.append(c);
      const angle = Math.random() * Math.PI - Math.PI; // vers le haut, en éventail
      const force = 120 + Math.random() * 160;
      const dx = Math.cos(angle) * force;
      const dy = Math.sin(angle) * force;
      const tour = (Math.random() - 0.5) * 720;
      c.animate(
        [
          { transform: 'translate(-50%, -50%) rotate(0deg)', opacity: 1 },
          { transform: `translate(${dx}px, ${dy}px) rotate(${tour / 2}deg)`, opacity: 1, offset: 0.45 },
          { transform: `translate(${dx * 1.3}px, ${dy + 260}px) rotate(${tour}deg)`, opacity: 0 },
        ],
        { duration: 1600 + Math.random() * 900, easing: 'cubic-bezier(0.2, 0.7, 0.4, 1)' },
      ).onfinish = () => c.remove();
    }
  }

  document.querySelectorAll<HTMLFormElement>('form[data-presence]').forEach((form) => {
    const message = form.querySelector<HTMLElement>('.message')!;
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const donnees = Object.fromEntries(new FormData(form));
      bouton.disabled = true;
      message.dataset.etat = '';
      message.textContent = 'Envoi en cours…';

      try {
        const reponse = await fetch(`/api/${form.dataset.presence}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(donnees),
        });
        const corps = await reponse.json().catch(() => ({}));
        if (!reponse.ok) throw new Error(corps.erreur ?? "L'envoi a échoué, merci de réessayer.");

        form.reset();
        lancerConfettis(bouton);
        message.dataset.etat = 'ok';
        message.textContent = corps.message ?? 'Merci, votre réponse est bien enregistrée !';
      } catch (erreur) {
        message.dataset.etat = 'erreur';
        message.textContent =
          erreur instanceof Error ? erreur.message : "L'envoi a échoué, merci de réessayer.";
      } finally {
        bouton.disabled = false;
      }
    });
  });
</script>

<style>
  .formulaire {
    display: grid;
    gap: 1rem;
    text-align: left;
  }

  .ligne {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  label {
    min-width: 0;
  }

  input {
    width: 100%;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--brun-cendre);
    border-radius: 0.5rem;
    background: #fffdf9;
    color: var(--cafe-noir);
    font: inherit;
    font-size: 1rem;
  }

  .bouton {
    justify-self: center;
  }

  .bouton:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .message {
    min-height: 1.5em;
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
  }

  .message[data-etat='ok'] {
    color: var(--olive);
    font-weight: 600;
  }

  .message[data-etat='erreur'] {
    color: #8a3b12;
    font-weight: 600;
  }
</style>
