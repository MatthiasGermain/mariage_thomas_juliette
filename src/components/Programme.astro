---
import { programme } from '../data/content';

const [apport, ceremonie, vin] = programme;
---

<section id="programme" class="programme rayures">
  <h2 class="titre-section" data-revele="ecrit">Le programme</h2>

  <!-- Liste accessible (lue par les lecteurs d'écran, affichée sur mobile) -->
  <ol class="liste">
    {
      programme.map((e, i) => (
        <li data-revele style={`--delai: ${i * 0.1}s`}>
          <span class="pastille script" aria-hidden="true">{e.heure}</span>
          <span class="visually-hidden">{e.heure} : </span>
          <strong class="titre">{e.titre}</strong>
          <span class="sous-titre script">{e.sousTitre}</span>
          <span class="detail">{e.detail}</span>
          <img class:list={['illus', e.illustration.split('/').pop()?.split('.')[0]]} src={e.illustration} alt="" loading="lazy" />
        </li>
      ))
    }
  </ol>

  <!--
    Frise de la maquette (ordinateur et tablette), recomposée à partir des éléments fournis
    (vague.png, plats/bague/verre.png) pour animer chaque morceau. Repère : maquette en 1366px
    de large ; positions relevées sur « vague +illus.png » (échelle 0,4688).
    Ordre d'apparition : la bande se dévoile, puis chaque étape (rond, titre, gravure).
  -->
  <svg class="frise" viewBox="0 0 1366 350" aria-hidden="true" data-revele="scene">
    <defs>
      <clipPath id="frise-rideau">
        <rect class="rideau" x="200" y="0" width="1000" height="350"></rect>
      </clipPath>
    </defs>

    <image
      href="/images/deco/vague.webp"
      x="223.7"
      y="32.2"
      width="949.3"
      height="270.5"
      clip-path="url(#frise-rideau)"></image>

    <!-- 13h : apport des plats -->
    <g class="etape" style="--delai: 0.3s">
      <g class="rond">
        <circle cx="234.7" cy="72.3" r="45.7"></circle>
        <text class="heure" x="234.7" y="86">{apport.heure}</text>
      </g>
      <g class="titres">
        <text class="titre-frise" x="228" y="155">{apport.titre}</text>
        <text class="sous-frise" x="220" y="180">{apport.sousTitre}</text>
      </g>
      <g class="survol plats"><image class="gravure" href="/images/deco/plats.webp" x="240" y="188" width="160" height="154"></image></g>
    </g>

    <!-- 14h : cérémonie -->
    <g class="etape" style="--delai: 0.9s">
      <g class="rond">
        <circle cx="642.1" cy="141.2" r="45.7"></circle>
        <text class="heure" x="642.1" y="155">{ceremonie.heure}</text>
      </g>
      <g class="survol bague"><image class="gravure" href="/images/deco/bague.webp" x="700" y="106.5" width="107" height="100"></image></g>
      <g class="titres">
        <text class="titre-frise grand" x="700" y="245">{ceremonie.titre}</text>
        <text class="sous-frise" x="700" y="272">{ceremonie.sousTitre}</text>
      </g>
    </g>

    <!-- 16h : vin d'honneur -->
    <g class="etape" style="--delai: 1.5s">
      <g class="rond">
        <circle cx="1042" cy="60.3" r="46.6"></circle>
        <text class="heure" x="1042" y="74">{vin.heure}</text>
      </g>
      <g class="titres">
        <text class="titre-frise" x="1045" y="140">{vin.titre}</text>
        <text class="sous-frise" x="1045" y="165">{vin.sousTitre}</text>
      </g>
      <g class="survol verre"><image class="gravure" href="/images/deco/verre.webp" x="1119.5" y="118" width="128" height="130"></image></g>
    </g>
  </svg>

</section>

<style>
  .programme {
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(3rem, 6vw, 5rem);
  }

  .titre-section {
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }

  .frise {
    display: block;
    width: 100%;
    max-width: 1366px;
    margin-inline: auto;
    height: auto;
    overflow: visible;
  }

  .titre-frise {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 27px;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    fill: var(--brun-cendre);
    text-anchor: middle;
  }

  .titre-frise.grand {
    font-size: 38px;
  }

  .sous-frise {
    font-family: var(--font-script);
    font-size: 30px;
    fill: var(--olive);
    text-anchor: middle;
  }

  .rond circle {
    fill: var(--abricot);
  }

  .heure {
    font-family: var(--font-script);
    font-size: 44px;
    fill: var(--papier);
    text-anchor: middle;
  }

  /* Repères de transformation dans le SVG : chaque élément tourne / grandit sur lui-même */
  .rond,
  .gravure,
  .survol,
  .titres,
  .rideau {
    transform-box: fill-box;
    transform-origin: center;
  }

  .rideau {
    transform-origin: left center;
  }

  .verre,
  .verre .gravure {
    transform-origin: 50% 90%;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* La bande se dévoile de gauche à droite comme un chemin qu'on parcourt */
    :global(.anim) .frise .rideau {
      scale: 0 1;
      transition: scale 2.2s cubic-bezier(0.45, 0.05, 0.35, 1);
    }

    :global(.anim) .frise .rond {
      opacity: 0;
      scale: 0.4;
      transition:
        opacity 0.5s var(--ease-papier) var(--delai),
        scale 0.8s cubic-bezier(0.34, 1.5, 0.64, 1) var(--delai);
    }

    :global(.anim) .frise .titres {
      opacity: 0;
      translate: 0 12px;
      transition:
        opacity 0.8s var(--ease-papier) calc(var(--delai) + 0.25s),
        translate 0.8s var(--ease-papier) calc(var(--delai) + 0.25s);
    }

    :global(.anim) .frise .gravure {
      opacity: 0;
    }

    :global(.anim) .frise.visible .rideau,
    :global(.anim) .frise.visible .rond {
      scale: 1;
    }

    :global(.anim) .frise.visible .rond,
    :global(.anim) .frise.visible .titres {
      opacity: 1;
      translate: 0 0;
    }

    :global(.anim) .frise.visible .gravure {
      opacity: 1;
      animation: poser 1.1s var(--ease-papier) calc(var(--delai) + 0.45s) both;
    }

    /* Une fois posées, les flûtes trinquent une fois */
    :global(.anim) .frise.visible .verre .gravure {
      animation:
        poser 1.1s var(--ease-papier) calc(var(--delai) + 0.45s) both,
        trinquer 0.9s ease-in-out calc(var(--delai) + 1.7s);
    }

    /* Le survol anime le groupe <g class="survol"> et pas l'image : l'animation de pose
       de l'image n'est jamais remplacée, donc la gravure ne disparaît pas. */
    .frise .verre:hover {
      animation: trinquer 0.9s ease-in-out;
    }

    .frise .bague:hover,
    .illus.bague:hover {
      animation: tourner 1s ease-in-out;
    }

    .frise .plats:hover,
    .illus.plats:hover {
      animation: fumer 0.8s ease-in-out;
    }

    .illus.verre:hover {
      animation: trinquer 0.9s ease-in-out;
    }
  }

  @keyframes trinquer {
    0%,
    100% {
      rotate: 0deg;
    }
    20% {
      rotate: -7deg;
    }
    45% {
      rotate: 5deg;
    }
    70% {
      rotate: -2deg;
    }
  }

  @keyframes tourner {
    0%,
    100% {
      rotate: 0deg;
    }
    35% {
      rotate: -12deg;
    }
    70% {
      rotate: 6deg;
    }
  }

  @keyframes fumer {
    0%,
    100% {
      translate: 0 0;
    }
    40% {
      translate: 0 -6px;
    }
  }

  .liste {
    display: none;
  }


  /* Mobile : la frise devient une liste verticale */
  @media (max-width: 47.99rem) {
    .frise {
      display: none;
    }

    .liste {
      display: grid;
      gap: 1.25rem;
      width: min(22rem, 100% - 2 * var(--gouttiere));
      margin: 0 auto;
      padding: 0;
      list-style: none;
    }

    .liste li {
      display: grid;
      justify-items: center;
      padding: 1.5rem 1rem 1.25rem;
      border-radius: 2rem;
      background: var(--creme-amande);
      text-align: center;
    }

    .pastille {
      display: grid;
      place-items: center;
      width: 4.5rem;
      aspect-ratio: 1;
      margin-top: -3rem;
      border-radius: 50%;
      background: var(--abricot);
      color: var(--papier);
      font-size: 2rem;
    }

    .titre {
      margin-top: 0.5rem;
      font-family: var(--font-serif);
      font-size: 1.5rem;
      line-height: 1.1;
      text-transform: uppercase;
      color: var(--brun-cendre);
    }

    .sous-titre {
      font-size: 1.6rem;
      line-height: 1;
      color: var(--olive);
      margin-top: -0.2rem;
    }

    .detail {
      margin-top: 0.5rem;
      font-size: 0.9rem;
    }

    .illus {
      max-height: 7rem;
      width: auto;
      margin-top: 0.75rem;
    }

    .liste li:first-child {
      margin-top: 1.5rem;
    }

    .liste li + li {
      margin-top: 1.5rem;
    }
  }

  /* Au-delà du mobile, la liste reste lisible par les lecteurs d'écran */
  @media (min-width: 48rem) {
    .liste {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
