---
import { verset } from '../data/content';

// Une phrase = un morceau qui apparaît à son tour
const phrases = verset.texte.split(/(?<=\.)\s+/);
---

<section class="verset" aria-label="Verset de mariage">
  <blockquote>
    <p>
      {
        phrases.map((phrase, i) => (
          <span class="phrase" data-revele="fondu" style={`--delai: ${0.15 + i * 0.22}s`}>
            {i === 0 && '«'}
            {phrase}
            {i === phrases.length - 1 && '»'}{' '}
          </span>
        ))
      }
    </p>
    <footer data-revele style={`--delai: ${0.3 + phrases.length * 0.22}s`}>
      {verset.reference}
    </footer>
  </blockquote>
</section>

<style>
  .verset {
    background: var(--brun-cendre);
    color: var(--creme-clair);
    padding: clamp(2rem, 3.5vw, 3rem) var(--gouttiere) clamp(2.25rem, 4vw, 3.25rem);
  }

  blockquote {
    margin: 0 auto;
    max-width: 62rem;
    text-align: center;
  }

  p {
    margin: 0 0 1.4rem;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(0.85rem, 1.35vw, 1.15rem);
    line-height: 1.3;
    letter-spacing: 0.13em;
  }

  footer {
    font-weight: 700;
    font-size: clamp(0.85rem, 1.35vw, 1.15rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

</style>
