---
// Questions fréquentes (maquette) : questions dépliables sur fond abricot.
import { contact, faq } from '../data/content';

// Une question sans réponse reste masquée tant qu'elle n'est pas complétée dans content.ts.
const questions = faq.filter((q) => q.reponse);
const tel = `tel:+33${contact.telephone.replace(/\s/g, '').slice(1)}`;
---

<section id="faq" class="faq" aria-labelledby="faq-titre">
  <h2 id="faq-titre" class="titre" data-revele>FAQ</h2>

  <div class="questions">
    {
      questions.map((q, i) => (
        <details data-revele style={`--delai: ${0.1 + i * 0.06}s`}>
          <summary>
            {q.question}
            <span class="icone" aria-hidden="true" />
          </summary>
          <div class="reponse">
            {q.reponse.split('\n').map((paragraphe) => <p>{paragraphe}</p>)}
          </div>
        </details>
      ))
    }
  </div>

  <p class="contact" data-revele>
    Pour toutes autres questions, contactez {contact.nom}&nbsp;: <a href={tel}>{contact.telephone}</a>
  </p>
</section>

<script>
  // Ouverture et fermeture en douceur : on anime la hauteur du <details>, que le navigateur
  // ouvre et ferme d'un coup sinon. La classe « ouvert » pilote l'icône et le fondu du texte.
  const DUREE = 450;
  const COURBE = 'cubic-bezier(0.33, 1, 0.68, 1)';

  document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((details) => {
    const summary = details.querySelector('summary')!;
    const reponse = details.querySelector<HTMLElement>('.reponse')!;
    let animation: Animation | undefined;

    summary.addEventListener('click', (event) => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      event.preventDefault();

      const depart = details.offsetHeight;
      const ouvrir = !details.classList.contains('ouvert');
      animation?.cancel();
      details.classList.toggle('ouvert', ouvrir);
      details.open = true;
      const fin = ouvrir ? details.offsetHeight : details.offsetHeight - reponse.offsetHeight;

      animation = details.animate({ height: [`${depart}px`, `${fin}px`] }, { duration: DUREE, easing: COURBE });
      animation.onfinish = () => {
        animation = undefined;
        if (!ouvrir) details.open = false;
      };
    });

    // Ouverture sans animation (mouvements réduits, recherche dans la page…) : l'icône suit.
    details.addEventListener('toggle', () => {
      if (!animation) details.classList.toggle('ouvert', details.open);
    });
  });
</script>

<style>
  .faq {
    padding: clamp(3rem, 6vw, 5rem) var(--gouttiere) clamp(3rem, 6vw, 4.5rem);
    background: var(--abricot);
    color: var(--cafe-noir);
  }

  .titre {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 700;
    text-align: center;
    color: var(--brun-cendre);
  }

  .questions {
    width: min(100%, 56rem);
    margin: clamp(2rem, 4vw, 3rem) auto 0;
  }

  details {
    border-bottom: 1px solid var(--brun-cendre);
  }

  /* Texte foncé : le blanc de la maquette ne se lit pas assez sur l'abricot */
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* « + » dessiné en deux traits : le trait vertical se couche pour donner « − » */
  .icone {
    position: relative;
    flex-shrink: 0;
    width: 0.85rem;
    height: 0.85rem;
    transition: rotate 0.45s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .icone::before,
  .icone::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -0.75px;
    border-radius: 1px;
    background: currentColor;
    transition: rotate 0.45s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .icone::after {
    rotate: 90deg;
  }

  details.ouvert .icone {
    rotate: 180deg;
  }

  details.ouvert .icone::after {
    rotate: 0deg;
  }

  details {
    overflow: hidden;
  }

  .reponse {
    padding-bottom: 1.25rem;
    transition:
      opacity 0.35s ease,
      translate 0.45s cubic-bezier(0.33, 1, 0.68, 1);
  }

  /* Fondu du texte, seulement quand les animations sont actives (sinon il reste visible) */
  :global(.anim) details:not(.ouvert) .reponse {
    opacity: 0;
    translate: 0 -0.4rem;
  }

  details.ouvert .reponse {
    transition-delay: 0.08s;
  }

  summary:focus-visible {
    outline: 2px solid var(--cafe-noir);
    outline-offset: 4px;
  }

  details p {
    margin: 0;
    max-width: 46rem;
    line-height: 1.6;
  }

  details p + p {
    margin-top: 0.6em;
  }

  .contact {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .contact a {
    white-space: nowrap;
  }
</style>
