---
const gauche = [
  { href: '#bienvenue', label: 'Bienvenue' },
  { href: '#presence', label: 'Présence' },
];
const droite = [
  { href: '#programme', label: 'Programme' },
  { href: '#lieu', label: 'Lieu' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="entete">
  <nav class="nav" aria-label="Navigation principale">
    <ul>
      {gauche.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <a href="#bienvenue" class="logo" aria-label="Retour en haut">
      <img src="/images/logo.png" alt="Monogramme J T, 27 03" width="120" height="120" />
    </a>
    <ul>
      {droite.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .entete {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    padding: clamp(0.75rem, 2.5vw, 2rem) clamp(1rem, 7vw, 6rem) 0;
  }

  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 1rem;
  }

  ul {
    display: flex;
    gap: clamp(1rem, 5.8vw, 5rem);
    margin: 0;
    padding: clamp(0.5rem, 1.5vw, 1.5rem) 0 0;
    list-style: none;
  }

  ul:last-child {
    justify-content: flex-end;
  }

  a {
    font-size: clamp(0.7rem, 1.2vw, 1.05rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--brun-cendre);
  }

  ul a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* Le logo PNG a un fond blanc et des marges : on le recadre et on fond le blanc. */
  .logo {
    display: block;
    /* Calé sur la largeur d'une rayure : le médaillon tient dans la bande verte du milieu */
    width: calc(var(--rayure) * 0.92);
    aspect-ratio: 68 / 86;
    overflow: hidden;
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* translateX : le médaillon est décalé vers la gauche dans le PNG, on le recentre */
    transform: scale(1.7) translateX(2%);
    mix-blend-mode: multiply;
  }

  @media (max-width: 40rem) {
    ul {
      flex-direction: column;
      gap: 0.35rem;
      padding-top: 0.25rem;
    }
    ul:last-child {
      align-items: flex-end;
    }
  }
</style>
