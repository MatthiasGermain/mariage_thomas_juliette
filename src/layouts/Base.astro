---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Juliette & Thomas · 27.03.27',
  description = 'Mariage de Juliette & Thomas, le 27 mars 2027 au Domaine des Templiers.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <!-- Active les animations seulement si le JS tourne (sinon tout reste visible) -->
    <script is:inline>document.documentElement.classList.add('anim');</script>
    <!-- Le titre du haut de page est en Sloop : on la charge tout de suite -->
    <link rel="preload" href="/fonts/sloop-scriptone.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Playfair+Display:wght@700&display=swap"
    />
  </head>
  <body>
    <slot />

    <script>
      // Apparition au défilement : ajoute .visible aux éléments [data-revele] quand ils entrent à l'écran.
      const elements = document.querySelectorAll<HTMLElement>('[data-revele]');
      if (!('IntersectionObserver' in window)) {
        elements.forEach((el) => el.classList.add('visible'));
      } else {
        // Un titre « écrit » est masqué par clip-path : sa surface visible est nulle et
        // l'observateur ne le verrait jamais entrer. On observe donc son parent à sa place.
        const cibles = new Map<Element, HTMLElement[]>();
        elements.forEach((el) => {
          const observe = el.dataset.revele === 'ecrit' && el.parentElement ? el.parentElement : el;
          cibles.set(observe, [...(cibles.get(observe) ?? []), el]);
        });
        const observateur = new IntersectionObserver(
          (entrees) => {
            for (const entree of entrees) {
              if (!entree.isIntersecting) continue;
              cibles.get(entree.target)?.forEach((el) => el.classList.add('visible'));
              observateur.unobserve(entree.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        cibles.forEach((_, el) => observateur.observe(el));
      }
    </script>
  </body>
</html>
